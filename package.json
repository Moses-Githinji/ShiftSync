{
  "name": "shiftsync",
  "private": true,
  "scripts": {
    "dev": "pnpm run --parallel dev:api dev:web",
    "dev:api": "pnpm --filter @shiftsync/api dev",
    "dev:web": "pnpm --filter @shiftsync/web dev",
    "build": "prisma generate && pnpm run -r build",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "lint": "pnpm run -r lint",
    "test": "pnpm run -r test"
  },
  "devDependencies": {
    "@prisma/config": "^7.10.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.23.1",
    "prisma": "^7.10.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/passport": "^12.0.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@types/luxon": "^3.7.5",
    "@types/node": "^22.20.2",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "luxon": "^3.7.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.0",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1"
  }
}
